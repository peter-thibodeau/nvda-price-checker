<Window x:Class="NVDAPriceChecker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NVDA Price Checker" Height="300" Width="500" Background="#F5F5F5" WindowStartupLocation="CenterScreen">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="20">
            <TextBlock Text="NVIDIA (NVDA) Stock Price" FontSize="28" FontWeight="Bold" Foreground="#1F1F1F" TextAlignment="Center"/>
            
            <Border Background="White" CornerRadius="8" Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" Spacing="10">
                        <TextBlock Text="Current Price" FontSize="14" Foreground="#666666"/>
                        <TextBlock x:Name="PriceTextBlock" Text="--" FontSize="32" FontWeight="Bold" Foreground="#00B050"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="1" Spacing="10">
                        <TextBlock Text="Change" FontSize="14" Foreground="#666666"/>
                        <TextBlock x:Name="ChangeTextBlock" Text="--" FontSize="24" FontWeight="Bold" Foreground="#FF6B6B"/>
                    </StackPanel>
                </Grid>
            </Border>
            
            <Button x:Name="RefreshButton" Content="Refresh Price" Click="RefreshButton_Click" 
                    Background="#0078D4" Foreground="White" Padding="12,8" FontSize="14" FontWeight="Bold" 
                    Cursor="Hand"/>
            
            <TextBlock x:Name="LastUpdatedTextBlock" Text="Last updated: --" FontSize="12" 
                       Foreground="#999999" TextAlignment="Center"/>
            
            <TextBlock x:Name="StatusTextBlock" Text="Click 'Refresh Price' to fetch the current price" FontSize="12" 
                       Foreground="#666666" TextAlignment="Center" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Window>
